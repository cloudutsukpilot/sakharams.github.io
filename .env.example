# Cloudflare Workers AI - used by the cloudutsuk-image-level-3 skill (flux-1-schnell)
# Account ID: Cloudflare dashboard -> Workers & Pages -> Overview (right sidebar)
# API Token:  My Profile -> API Tokens -> Create Token (needs "Workers AI" permission)
# Copy to .env (gitignored) and fill in.
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
